<?xml version="1.0"?>
<Container version="2">
  <Name>foto-exif</Name>
  <Repository>ghcr.io/paulg67/foto-exif:latest</Repository>
  <Registry>https://github.com/users/PaulG67/packages/container/package/foto-exif</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PaulG67/foto-exif/issues</Support>
  <Project>https://github.com/PaulG67/foto-exif</Project>
  <Overview>
Foto-exif setzt EXIF-Aufnahmedaten (DateTimeOriginal) für gescannte JPEGs — damit Immich sie chronologisch richtig einordnet. Speichert direkt in die gemounteten Dateien (nur Metadaten, keine Neukomprimierung).

SETUP / Vorlage installieren (Unraid-Terminal):
bash &lt;(curl -fsSL https://raw.githubusercontent.com/PaulG67/foto-exif/main/unraid/install-template.sh)

Danach: Docker → Container hinzufügen → Template «foto-exif» → Photos-Pfad setzen → Apply.
Updates: Docker → foto-exif → Force Update (Vorlage aktualisieren: Script erneut ausführen, dann ggf. Edit → Apply).
  </Overview>
  <Category>MediaApp:Photos Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8791]/WebUI>
  <TemplateURL>https://raw.githubusercontent.com/PaulG67/foto-exif/main/unraid/my-foto-exif.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/PaulG67/foto-exif/main/unraid/icon.svg</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI Port" Target="8791" Default="8791" Mode="tcp" Description="Web-Oberfläche Foto-exif" Type="Port" Display="always" Required="true" Mask="false">8791</Config>
  <Config Name="Photos" Target="/photos" Default="/mnt/user/photos" Mode="rw" Description="Foto-/Scan-Ordner mit Schreibzugriff (JPEGs)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/photos</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User-ID (Unraid nobody = 99)" Type="Variable" Display="advanced" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group-ID (Unraid users = 100)" Type="Variable" Display="advanced" Required="false" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="Europe/Zurich" Mode="" Description="Zeitzone" Type="Variable" Display="advanced" Required="false" Mask="false">Europe/Zurich</Config>
  <Config Name="PORT" Target="PORT" Default="8791" Mode="" Description="Interner Port (meist unverändert lassen)" Type="Variable" Display="advanced" Required="false" Mask="false">8791</Config>
  <Config Name="PHOTOS_ROOT" Target="PHOTOS_ROOT" Default="/photos" Mode="" Description="Pfad im Container zum Foto-Volume" Type="Variable" Display="advanced" Required="false" Mask="false">/photos</Config>
</Container>
